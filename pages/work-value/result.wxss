.page { min-height: 100vh; padding: 30rpx 30rpx 44rpx; box-sizing: border-box; }.masthead { display: flex; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 4rpx solid #111; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.hero { display: flex; flex-direction: column; align-items: center; padding: 38rpx 26rpx; color: #fff; background: #111; }.eyebrow { font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; opacity: .7; }.score { display: flex; align-items: baseline; margin: 22rpx 0 12rpx; }.score text:first-child { font-size: 100rpx; font-weight: 800; line-height: 1; }.score text:last-child { font-size: 24rpx; opacity: .7; }.title { font-size: 40rpx; font-weight: 800; }.tagline { margin-top: 12rpx; font-size: 24rpx; text-align: center; opacity: .85; }
.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }.metric { display: flex; flex-direction: column; min-height: 158rpx; padding: 22rpx; border: 3rpx solid #111; background: #fff; font-size: 24rpx; font-weight: 700; }.metric-wide { grid-column: 1 / 3; min-height: 136rpx; }.metric-value { display: block; margin-top: auto; font-size: 43rpx; font-weight: 800; }.metric-value text { font-size: 24rpx; }.metric-note { margin-top: 4rpx; color: #666; font-size: 24rpx; font-weight: 400; }
.report-block { margin-top: 18rpx; padding: 26rpx; border: 3rpx solid #111; background: #fff; }.report-dark { color: #fff; background: #111; }.block-no { display: block; margin-bottom: 16rpx; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.block-title { display: block; margin-bottom: 12rpx; font-size: 32rpx; font-weight: 800; }.block-copy { display: block; color: #333; font-size: 25rpx; line-height: 1.62; }.report-dark .block-copy { color: #fff; }.facts { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 12rpx 16rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 2rpx solid #111; color: #666; font-size: 24rpx; }.facts text:nth-child(even) { color: #111; font-weight: 700; text-align: right; }.report-dark .facts { border-color: #fff; color: #bbb; }.report-dark .facts text:nth-child(even) { color: #fff; }
.actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 26rpx; }.actions button { width: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; margin: 0; padding: 0 8rpx; border: 3rpx solid #111; font-size: 24rpx; font-weight: 800; line-height: 1.2; }.actions button::after { border: none; }.primary { color: #fff; background: #111; }.secondary { color: #111; background: #fff; }.report-canvas { position: fixed; left: -10000rpx; top: 0; width: 750px; height: 2200px; pointer-events: none; }
