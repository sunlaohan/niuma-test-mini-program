.page { min-height: 100vh; padding: 30rpx 30rpx 44rpx; box-sizing: border-box; }.masthead { display: flex; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 4rpx solid #111; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }
.panel { margin-top: 18rpx; padding: 26rpx; border: 3rpx solid #111; background: #fff; }.panel-title { display: block; margin-bottom: 22rpx; font-size: 31rpx; font-weight: 800; }.control-label { display: block; margin-bottom: 12rpx; color: #555; font-size: 24rpx; }.control-label-gap { margin-top: 24rpx; }.control-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx 18rpx; }.control { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; height: 86rpx; padding: 0 20rpx; border: 2rpx solid #111; background: #f4f4f1; color: #111; font-size: 27rpx; font-weight: 600; }.control-full { width: 100%; }.control input { width: 100%; height: 100%; font-size: 28rpx; font-weight: 600; }.picker-control { display: block; padding: 0; }.picker-inner { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; height: 86rpx; padding: 0 20rpx; }.picker-inner text:first-child { max-width: calc(100% - 34rpx); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.picker-inner text:last-child { flex: 0 0 auto; margin-left: 12rpx; color: #555; font-size: 24rpx; }.switch-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; margin-top: 22rpx; border-top: 2rpx solid #111; font-size: 26rpx; font-weight: 700; }.switch-row switch { transform: scale(.85); transform-origin: right center; }.submit { display: flex; align-items: center; justify-content: center; width: 100% !important; height: 96rpx; margin: 28rpx 0 0; padding: 0; color: #fff; border: 3rpx solid #111; background: #111; font-size: 27rpx; font-weight: 800; }.submit::after { border: none; }.note { display: block; margin-top: 18rpx; color: #666; font-size: 24rpx; text-align: center; }
