.page { min-height: 100vh; padding: 30rpx 30rpx 44rpx; box-sizing: border-box; }.masthead { display: flex; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 4rpx solid #111; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.hero { display: flex; flex-direction: column; align-items: center; padding: 36rpx 24rpx; color: #fff; background: #111; text-align: center; }.eyebrow { font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; opacity: .7; }.type { margin-top: 24rpx; font-size: 80rpx; font-weight: 800; line-height: 1; }.type-name { margin-top: 14rpx; font-size: 38rpx; font-weight: 800; }.block { margin-top: 18rpx; padding: 26rpx; border: 3rpx solid #111; background: #fff; }.block-no { display: block; margin-bottom: 16rpx; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.block-copy { display: block; color: #333; font-size: 27rpx; line-height: 1.62; white-space: pre-line; }.quote { display: flex; gap: 16rpx; margin-top: 18rpx; padding: 25rpx; color: #fff; background: #111; font-size: 29rpx; font-weight: 700; line-height: 1.45; }.quote text:first-child { font-size: 46rpx; line-height: .85; }.scores-intro { display: block; margin: -4rpx 0 18rpx; color: #666; font-size: 24rpx; line-height: 1.5; }.scores { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.score-cell { display: flex; flex-direction: column; justify-content: center; min-height: 132rpx; padding: 18rpx; border: 2rpx solid #111; }.score-label { font-size: 24rpx; font-weight: 800; }.score-result { display: block; margin-top: 9rpx; font-size: 27rpx; font-weight: 800; }.score-detail { display: block; margin-top: 8rpx; color: #666; font-size: 24rpx; line-height: 1.35; }.actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }.actions button { width: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; margin: 0; padding: 0 8rpx; border: 3rpx solid #111; font-size: 24rpx; font-weight: 800; line-height: 1.2; }.actions button::after { border: none; }.primary { color: #fff; background: #111; }.secondary { color: #111; background: #fff; }.report-canvas { position: fixed; left: -10000rpx; top: 0; width: 750px; height: 2200px; pointer-events: none; }
