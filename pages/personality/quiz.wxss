.page { min-height: 100vh; padding: 32rpx 30rpx 42rpx; box-sizing: border-box; }.top { margin-bottom: 32rpx; }.top-copy { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.track { height: 12rpx; background: #d5d5d1; }.fill { height: 100%; background: #111; transition: width .2s ease; }.question-card { padding: 30rpx 26rpx 26rpx; border: 3rpx solid #111; background: #fff; }.question-no { display: block; margin-bottom: 26rpx; font-size: 24rpx; font-weight: 800; }.question { display: block; min-height: 90rpx; font-size: 46rpx; font-weight: 800; line-height: 1.28; }.options { display: flex; flex-direction: column; gap: 13rpx; margin-top: 28rpx; }.option { display: flex; align-items: center; min-height: 92rpx; padding: 0 20rpx; border: 2rpx solid #111; background: #f4f4f1; font-size: 28rpx; font-weight: 600; }.option.selected { color: #fff; background: #111; }.option-index { width: 62rpx; color: #777; font-size: 24rpx; font-weight: 800; }.option.selected .option-index { color: #fff; }.actions { display: flex; gap: 14rpx; margin-top: 24rpx; }.actions button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 88rpx; margin: 0; padding: 0; border: 3rpx solid #111; font-size: 26rpx; font-weight: 800; }.actions button::after { border: none; }.back { width: 196rpx; color: #111; background: #fff; }.back[disabled] { border-color: #bbb; color: #aaa; }.next { flex: 1; color: #fff; background: #111; }.next.disabled { opacity: .35; }.note { display: block; margin-top: 22rpx; color: #666; font-size: 24rpx; text-align: center; }
