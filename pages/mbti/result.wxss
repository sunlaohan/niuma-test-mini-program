.page { min-height: 100vh; padding: 30rpx 30rpx 44rpx; box-sizing: border-box; }.masthead { display: flex; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 4rpx solid #111; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.hero { display: flex; flex-direction: column; align-items: center; padding: 36rpx 24rpx; color: #fff; background: #111; text-align: center; }.eyebrow { font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; opacity: .7; }.type { margin-top: 24rpx; font-size: 80rpx; font-weight: 800; line-height: 1; }.type-name { margin-top: 14rpx; font-size: 38rpx; font-weight: 800; }.block { margin-top: 18rpx; padding: 26rpx; border: 3rpx solid #111; background: #fff; }.block-dark { color: #fff; background: #111; }.block-no { display: block; margin-bottom: 16rpx; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.block-copy { display: block; color: #333; font-size: 27rpx; line-height: 1.62; white-space: pre-line; }.block-dark .block-copy { color: #fff; }.dimensions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.dimension { min-height: 132rpx; padding: 18rpx; box-sizing: border-box; border: 2rpx solid #111; }.dimension-label { display: block; font-size: 24rpx; font-weight: 800; }.dimension-result { display: block; margin-top: 9rpx; font-size: 27rpx; font-weight: 800; }.dimension-detail { display: block; margin-top: 8rpx; color: #666; font-size: 24rpx; line-height: 1.35; }.actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }.actions button { width: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; margin: 0; padding: 0 8rpx; border: 3rpx solid #111; font-size: 24rpx; font-weight: 800; line-height: 1.2; }.actions button::after { border: none; }.primary { color: #fff; background: #111; }.secondary { color: #111; background: #fff; }.note { display: block; margin-top: 22rpx; color: #666; font-size: 24rpx; line-height: 1.5; text-align: center; }.report-canvas { position: fixed; left: -10000rpx; top: 0; width: 750px; height: 2200px; pointer-events: none; }
