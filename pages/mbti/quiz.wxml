<view class="page safe-bottom">
  <view class="top">
    <view class="top-copy"><text>04 / MBTI TENDENCIES</text><text>{{currentIndex + 1}} / {{questions.length}}</text></view>
    <view class="track"><view class="fill" style="width: {{progress}}%"></view></view>
  </view>
  <view class="question-card">
    <text class="question-no">第 {{currentIndex + 1}} 题</text>
    <text class="question">{{currentQuestion.statement}}</text>
    <view class="options">
      <view wx:for="{{scaleOptions}}" wx:key="*this" class="option {{selectedIndex === index ? 'selected' : ''}}" bindtap="selectOption" data-index="{{index}}"><text class="option-index">{{index + 1}}</text><text>{{item}}</text></view>
    </view>
    <view class="actions"><button class="back" bindtap="previous" disabled="{{currentIndex === 0}}">上一步</button><button class="next {{selectedIndex === -1 ? 'disabled' : ''}}" bindtap="next">{{currentIndex === questions.length - 1 ? '查看结果' : '下一题'}} →</button></view>
  </view>
  <text class="note">请按自然状态下真实的你作答，不是理想中的自己或被迫表现出来的样子。本测试为原创人格倾向测试，非官方 MBTI® 测评。</text>
</view>
