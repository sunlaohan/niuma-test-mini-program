.page { min-height: 100vh; padding: 30rpx 30rpx 44rpx; box-sizing: border-box; }.masthead { display: flex; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 4rpx solid #111; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.hero { display: flex; flex-direction: column; align-items: center; padding: 34rpx 24rpx; color: #fff; background: #111; text-align: center; }.eyebrow { font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; opacity: .7; }.score { margin-top: 18rpx; font-size: 86rpx; font-weight: 800; line-height: 1; }.score-unit { margin-top: 4rpx; font-size: 24rpx; opacity: .7; }.title { margin-top: 16rpx; font-size: 40rpx; font-weight: 800; }.tagline { margin-top: 10rpx; font-size: 24rpx; opacity: .85; }.block, .safety { margin-top: 18rpx; padding: 26rpx; border: 3rpx solid #111; background: #fff; }.block-no { display: block; margin-bottom: 16rpx; font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }.block-copy, .safety { color: #333; font-size: 27rpx; line-height: 1.62; white-space: pre-line; }.quote { display: flex; gap: 16rpx; margin-top: 18rpx; padding: 25rpx; color: #fff; background: #111; font-size: 29rpx; font-weight: 700; line-height: 1.45; }.quote text:first-child { font-size: 46rpx; line-height: .85; }.dimension + .dimension { margin-top: 22rpx; }.dimension-copy { display: flex; justify-content: space-between; margin-bottom: 10rpx; font-size: 25rpx; font-weight: 800; }.bar { height: 12rpx; background: #d5d5d1; }.bar-fill { height: 100%; background: #111; }.dimension-note { display: block; margin-top: 8rpx; color: #666; font-size: 24rpx; }.safety { color: #fff; background: #111; }.safety .block-no { color: #fff; }.actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }.actions button { width: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; margin: 0; padding: 0 8rpx; border: 3rpx solid #111; font-size: 24rpx; font-weight: 800; line-height: 1.2; }.actions button::after { border: none; }.primary { color: #fff; background: #111; }.secondary { color: #111; background: #fff; }.report-canvas { position: fixed; left: -10000rpx; top: 0; width: 750px; height: 2200px; pointer-events: none; }
